{
  "name": "nfz-atlas-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start": "ng serve --host 127.0.0.1",
    "build": "ng build",
    "check": "tsc --noEmit -p tsconfig.app.json",
    "test": "node --test tests/*.test.mjs",
    "prebuild": "node ../../scripts/prepare-web-data.mjs",
    "prestart": "node ../../scripts/prepare-web-data.mjs",
    "format": "prettier --write src tests *.json ../../scripts/*.mjs",
    "format:check": "prettier --check src tests *.json ../../scripts/*.mjs"
  },
  "dependencies": {
    "@angular/common": "^21.0.0",
    "@angular/compiler": "^21.0.0",
    "@angular/core": "^21.0.0",
    "@angular/forms": "^21.0.0",
    "@angular/platform-browser": "^21.0.0",
    "@angular/router": "^21.0.0",
    "chart.js": "^4.4.9",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "^21.0.0",
    "@angular/cli": "^21.0.0",
    "@types/leaflet": "^1.9.18",
    "@types/leaflet.markercluster": "^1.5.6",
    "prettier": "3.6.2",
    "typescript": "~5.9.2"
  },
  "overrides": {
    "rollup": "4.52.4"
  }
}
